// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeagueVisibility {
  PUBLIC
  PRIVATE
}

enum LeagueRole {
  COMMISSIONER
  CO_COMMISSIONER
  PLAYER
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  COMPLETE
}

enum EpisodeType {
  REGULAR
  FINALE
}

enum ShowType {
  SURVIVOR
  DRAG_RACE
  GENERIC
  TRAITORS
}

enum TraitorsElimination {
  NONE
  MURDERED
  BANISHED
}

enum TraitorsFantasyRole {
  FAITHFUL
  TRAITOR
}

enum TraitorsVoteType {
  BANISHMENT
  MURDER
}

enum MemberEffectType {
  NEXT_EPISODE_ZERO
  FORCE_MULTIPLIER_ONE
  BANISHMENT_IMMUNITY
}

enum MessageChannel {
  GENERAL
  TRAITORS
}

enum SurvivorDraftStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum SurvivorAuctionType {
  HIDDEN_BID
  LIVE
}

enum SurvivorAuctionStatus {
  SCHEDULED
  OPEN
  CLOSED
  RESOLVED
}

enum SurvivorAdvantageType {
  DOUBLE_EPISODE
  PREDICTION_SHIELD
  IDOL_INSURANCE
  VOTE_STEAL
  REVIVAL_TOKEN
  BOOT_BLOCK
  EXTRA_PREDICTION
}

enum SurvivorAdvantageStatus {
  ACTIVE
  USED
  EXPIRED
}

enum SurvivorPointSource {
  PERFORMANCE
  PREDICTION
  BOOT_ORDER
  AUCTION_SPEND
  AUCTION_REFUND
  ADVANTAGE_AWARD
  ADVANTAGE_EFFECT
  LAST_SURVIVOR_STANDING
  ADMIN_ADJUSTMENT
}

model TraitorsPlayer {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())

  league  League                        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  results TraitorsEpisodePlayerResult[]

  picks TraitorsEntryPick[]

  @@unique([leagueId, name])
  @@index([leagueId])
}

model TraitorsEpisodePlayerResult {
  id        String @id @default(cuid())
  episodeId String
  playerId  String

  elimination   TraitorsElimination @default(NONE)
  gotShield     Boolean             @default(false) // at most 1 per episode
  isShowTraitor Boolean             @default(false) // +1 if true

  episode Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  player  TraitorsPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([episodeId, playerId])
  @@index([episodeId])
  @@index([playerId])
}

model TraitorsEntryPick {
  id        String   @id @default(cuid())
  entryId   String
  playerId  String
  slot      Int // 1..5
  createdAt DateTime @default(now())

  entry  LeagueEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  player TraitorsPlayer @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([entryId, slot])
  @@unique([entryId, playerId])
  @@index([playerId])
  @@index([entryId])
}

model TraitorsFantasyRolePeriod {
  id             String @id @default(cuid())
  leagueId       String
  leagueMemberId String

  role TraitorsFantasyRole

  startsEpisodeId String
  endsEpisodeId   String?

  league League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [leagueMemberId], references: [id], onDelete: Cascade)

  startsEpisode Episode  @relation("TraitorsRoleStarts", fields: [startsEpisodeId], references: [id], onDelete: Cascade)
  endsEpisode   Episode? @relation("TraitorsRoleEnds", fields: [endsEpisodeId], references: [id], onDelete: SetNull)

  @@index([leagueId])
  @@index([leagueMemberId])
}

model TraitorsVote {
  id        String           @id @default(cuid())
  leagueId  String
  episodeId String
  type      TraitorsVoteType

  voterMemberId  String
  targetMemberId String

  createdAt DateTime @default(now())

  league  League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  episode Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  voter   LeagueMember @relation("TraitorsVoteVoter", fields: [voterMemberId], references: [id], onDelete: Cascade)
  target  LeagueMember @relation("TraitorsVoteTarget", fields: [targetMemberId], references: [id], onDelete: Cascade)

  @@unique([episodeId, type, voterMemberId])
  @@index([episodeId, type])
  @@index([targetMemberId])
}

model MemberEffect {
  id             String @id @default(cuid())
  leagueId       String
  leagueMemberId String

  type            MemberEffectType
  startsEpisodeId String
  endsEpisodeId   String

  createdAt DateTime @default(now())

  league League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [leagueMemberId], references: [id], onDelete: Cascade)

  startsEpisode Episode @relation("EffectStarts", fields: [startsEpisodeId], references: [id], onDelete: Cascade)
  endsEpisode   Episode @relation("EffectEnds", fields: [endsEpisodeId], references: [id], onDelete: Cascade)

  @@index([leagueId])
  @@index([leagueMemberId])
  @@index([startsEpisodeId])
  @@index([endsEpisodeId])
}

model LeagueMessage {
  id             String  @id @default(cuid())
  leagueId       String
  episodeId      String? // optional thread-per-episode
  authorMemberId String

  channel   MessageChannel @default(GENERAL)
  body      String
  createdAt DateTime       @default(now())

  league League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  author LeagueMember @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)

  @@index([leagueId, channel])
  @@index([episodeId])
}

model User {
  id             String         @id @default(cuid())
  name           String?
  displayName    String? // ✅ new
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  leaguesCreated League[]       @relation("LeaguesCreatedBy")
  leagueMembers  LeagueMember[]
  entries        LeagueEntry[] // ✅ ADD THIS
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model League {
  id         String           @id @default(cuid())
  name       String
  showType   ShowType
  visibility LeagueVisibility @default(PRIVATE)
  status     LeagueStatus     @default(DRAFT)
  maxPlayers Int              @default(12)

  // --- Drag Race / season config (MVP) ---
  seasonKey          String?
  startsAt           DateTime?
  submissionDeadline DateTime?
  startedAt          DateTime? // manual override for testing: if set, league is considered started/revealed

  // who created it (not necessarily the only commissioner)
  createdById String
  createdBy   User   @relation("LeaguesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  members LeagueMember[]
  invites LeagueInvite[]
  entries LeagueEntry[] // NEW

  episodes Episode[]

  traitorsPlayers        TraitorsPlayer[]
  traitorsFantasyPeriods TraitorsFantasyRolePeriod[]
  traitorsVotes          TraitorsVote[]
  memberEffects          MemberEffect[]
  messages               LeagueMessage[]

  survivorCastaways         SurvivorCastaway[]
  survivorDraft             SurvivorDraft?
  survivorEpisodeMeta       SurvivorEpisodeMeta[]
  survivorEpisodeResults    SurvivorEpisodeCastawayResult[]
  survivorPredictions       SurvivorWeeklyPrediction[]
  survivorBootOrder         SurvivorBootOrderSubmission[]
  survivorAuctions          SurvivorAuction[]
  survivorOwnedAdvantages   SurvivorOwnedAdvantage[]
  survivorPointTransactions SurvivorPointTransaction[]

  @@index([showType])
  @@index([createdById])
  @@index([seasonKey]) // NEW (optional but useful)
}

model LeagueMember {
  id       String     @id @default(cuid())
  leagueId String
  userId   String
  role     LeagueRole @default(PLAYER)
  joinedAt DateTime   @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  traitorsFantasyPeriods TraitorsFantasyRolePeriod[]

  traitorsVotesCast     TraitorsVote[] @relation("TraitorsVoteVoter")
  traitorsVotesReceived TraitorsVote[] @relation("TraitorsVoteTarget")

  memberEffects    MemberEffect[]
  messagesAuthored LeagueMessage[]

  @@unique([leagueId, userId])
  @@index([userId])
}

model LeagueInvite {
  id        String    @id @default(cuid())
  leagueId  String
  token     String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId])
}

model Queen {
  id        String   @id @default(cuid())
  seasonKey String
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())

  picks          LeagueEntryPick[] // ✅ ADD THIS
  episodeResults EpisodeResult[]

  finalePlacements EpisodeFinalePlacement[]
  finaleExtras     EpisodeFinaleExtra[]

  @@unique([seasonKey, name])
  @@index([seasonKey])
}

model SurvivorCastaway {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  tribe     String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  draftPicks                   SurvivorDraftPick[]
  episodeResults               SurvivorEpisodeCastawayResult[]
  bootPredictions              SurvivorWeeklyPrediction[] @relation("SurvivorPredictionBoot")
  immunityPredictions          SurvivorWeeklyPrediction[] @relation("SurvivorPredictionImmunityWinner")
  safePredictions              SurvivorWeeklyPrediction[] @relation("SurvivorPredictionSafePick")
  episodeMetasAsBoot           SurvivorEpisodeMeta[]      @relation("SurvivorEpisodeBoot")
  episodeMetasAsImmunityWinner SurvivorEpisodeMeta[]      @relation("SurvivorEpisodeImmunityWinner")
  bootOrderItems               SurvivorBootOrderItem[]

  @@unique([leagueId, name])
  @@index([leagueId])
}

model SurvivorDraft {
  id                 String              @id @default(cuid())
  leagueId           String              @unique
  status             SurvivorDraftStatus @default(NOT_STARTED)
  picksPerEntry      Int?
  totalRounds        Int?
  totalPicks         Int?
  currentOverallPick Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  seats SurvivorDraftSeat[]
  picks SurvivorDraftPick[]
}

model SurvivorDraftSeat {
  id            String   @id @default(cuid())
  draftId       String
  leagueEntryId String
  seat          Int
  createdAt     DateTime @default(now())

  draft       SurvivorDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  leagueEntry LeagueEntry   @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)

  @@unique([draftId, seat])
  @@unique([draftId, leagueEntryId])
  @@index([leagueEntryId])
}

model SurvivorDraftPick {
  id            String   @id @default(cuid())
  draftId       String
  leagueEntryId String
  castawayId    String
  round         Int
  overallPick   Int
  pickInRound   Int
  createdAt     DateTime @default(now())

  draft       SurvivorDraft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  leagueEntry LeagueEntry      @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)
  castaway    SurvivorCastaway @relation(fields: [castawayId], references: [id], onDelete: Restrict)

  @@unique([draftId, overallPick])
  @@unique([draftId, castawayId])
  @@unique([draftId, leagueEntryId, round])
  @@index([leagueEntryId])
  @@index([castawayId])
}

model SurvivorEpisodeMeta {
  id                       String   @id @default(cuid())
  leagueId                 String
  episodeId                String   @unique
  isMerge                  Boolean  @default(false)
  isNonElimination         Boolean  @default(false)
  wasIdolPlayed            Boolean  @default(false)
  shotInTheDarkPlayed      Boolean  @default(false)
  hadTribeSwap             Boolean  @default(false)
  bootCastawayId           String?
  bootVoteCount            Int?
  immunityWinnerCastawayId String?
  lockedAt                 DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  league                 League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  episode                Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  bootCastaway           SurvivorCastaway? @relation("SurvivorEpisodeBoot", fields: [bootCastawayId], references: [id], onDelete: SetNull)
  immunityWinnerCastaway SurvivorCastaway? @relation("SurvivorEpisodeImmunityWinner", fields: [immunityWinnerCastawayId], references: [id], onDelete: SetNull)

  @@index([leagueId])
  @@index([bootCastawayId])
  @@index([immunityWinnerCastawayId])
}

model SurvivorEpisodeCastawayResult {
  id                      String   @id @default(cuid())
  leagueId                String
  episodeId               String
  castawayId              String
  survived                Boolean  @default(true)
  eliminated              Boolean  @default(false)
  individualImmunityWins  Int      @default(0)
  individualRewardWins    Int      @default(0)
  advantagesFound         Int      @default(0)
  idolsPlayedSuccessfully Int      @default(0)
  votesReceived           Int      @default(0)
  confessionalLeader      Boolean  @default(false)
  endgamePlacement        Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  league   League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  episode  Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  castaway SurvivorCastaway @relation(fields: [castawayId], references: [id], onDelete: Restrict)

  @@unique([episodeId, castawayId])
  @@index([leagueId])
  @@index([castawayId])
}

model SurvivorWeeklyPrediction {
  id                       String   @id @default(cuid())
  leagueId                 String
  episodeId                String
  leagueEntryId            String
  bootCastawayId           String?
  bootVoteCount            Int?
  immunityWinnerCastawayId String?
  idolPlayed               Boolean?
  safePickCastawayId       String?
  shotInTheDarkPlayed      Boolean?
  tribeSwapHappens         Boolean?
  nonEliminationEpisode    Boolean?
  submittedAt              DateTime @default(now())
  scoredAt                 DateTime?
  points                   Decimal  @default(0) @db.Decimal(10, 2)
  breakdown                Json?

  league                 League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  episode                Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  leagueEntry            LeagueEntry       @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)
  bootCastaway           SurvivorCastaway? @relation("SurvivorPredictionBoot", fields: [bootCastawayId], references: [id], onDelete: SetNull)
  immunityWinnerCastaway SurvivorCastaway? @relation("SurvivorPredictionImmunityWinner", fields: [immunityWinnerCastawayId], references: [id], onDelete: SetNull)
  safePickCastaway       SurvivorCastaway? @relation("SurvivorPredictionSafePick", fields: [safePickCastawayId], references: [id], onDelete: SetNull)

  @@unique([episodeId, leagueEntryId])
  @@index([leagueId])
  @@index([leagueEntryId])
}

model SurvivorBootOrderSubmission {
  id             String   @id @default(cuid())
  leagueId       String
  leagueEntryId  String   @unique
  mergeEpisodeId String?
  submittedAt    DateTime @default(now())
  lockedAt       DateTime?
  scoredAt       DateTime?
  points         Decimal  @default(0) @db.Decimal(10, 2)
  breakdown      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  league       League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueEntry  LeagueEntry @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)
  mergeEpisode Episode?    @relation("SurvivorBootOrderMergeEpisode", fields: [mergeEpisodeId], references: [id], onDelete: SetNull)

  items SurvivorBootOrderItem[]

  @@index([leagueId])
  @@index([mergeEpisodeId])
}

model SurvivorBootOrderItem {
  id                String @id @default(cuid())
  submissionId      String
  castawayId        String
  predictedPosition Int

  submission SurvivorBootOrderSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  castaway   SurvivorCastaway            @relation(fields: [castawayId], references: [id], onDelete: Restrict)

  @@unique([submissionId, predictedPosition])
  @@unique([submissionId, castawayId])
  @@index([castawayId])
}

model SurvivorAuction {
  id         String               @id @default(cuid())
  leagueId   String
  name       String
  type       SurvivorAuctionType   @default(HIDDEN_BID)
  status     SurvivorAuctionStatus @default(SCHEDULED)
  opensAt    DateTime?
  closesAt   DateTime?
  resolvedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  lots SurvivorAuctionLot[]
  bids SurvivorAuctionBid[]

  @@index([leagueId])
}

model SurvivorAuctionLot {
  id            String                @id @default(cuid())
  auctionId     String
  advantageType SurvivorAdvantageType
  title         String
  description   String?
  quantity      Int                   @default(1)
  startingBid   Decimal               @default(0) @db.Decimal(10, 2)
  createdAt     DateTime              @default(now())

  auction SurvivorAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  bids            SurvivorAuctionBid[]
  ownedAdvantages SurvivorOwnedAdvantage[]

  @@index([auctionId])
}

model SurvivorAuctionBid {
  id            String   @id @default(cuid())
  auctionId     String
  lotId         String
  leagueEntryId String
  amount        Decimal  @db.Decimal(10, 2)
  isWinning     Boolean  @default(false)
  createdAt     DateTime @default(now())

  auction     SurvivorAuction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  lot         SurvivorAuctionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  leagueEntry LeagueEntry       @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([lotId])
  @@index([leagueEntryId])
  @@index([auctionId, lotId])
}

model SurvivorOwnedAdvantage {
  id                   String                  @id @default(cuid())
  leagueId             String
  leagueEntryId        String
  lotId                String?
  advantageType        SurvivorAdvantageType
  title                String
  status               SurvivorAdvantageStatus @default(ACTIVE)
  awardedAt            DateTime                @default(now())
  usedAt               DateTime?
  expiresEpisodeId     String?
  lastAppliedEpisodeId String?
  effectConfig         Json?

  league           League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueEntry      LeagueEntry  @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)
  lot              SurvivorAuctionLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  expiresEpisode   Episode?     @relation("SurvivorAdvantageExpiresEpisode", fields: [expiresEpisodeId], references: [id], onDelete: SetNull)
  lastAppliedEpisode Episode?   @relation("SurvivorAdvantageLastAppliedEpisode", fields: [lastAppliedEpisodeId], references: [id], onDelete: SetNull)

  pointTransactions SurvivorPointTransaction[]

  @@index([leagueId])
  @@index([leagueEntryId])
  @@index([expiresEpisodeId])
  @@index([lastAppliedEpisodeId])
}

model SurvivorPointTransaction {
  id               String              @id @default(cuid())
  leagueId         String
  leagueEntryId    String
  episodeId        String?
  ownedAdvantageId String?
  source           SurvivorPointSource
  amount           Decimal             @db.Decimal(10, 2)
  reason           String?
  metadata         Json?
  createdAt        DateTime            @default(now())

  league         League                   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueEntry    LeagueEntry              @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)
  episode        Episode?                 @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  ownedAdvantage SurvivorOwnedAdvantage?  @relation(fields: [ownedAdvantageId], references: [id], onDelete: SetNull)

  @@index([leagueId])
  @@index([leagueEntryId])
  @@index([episodeId])
  @@index([source])
}

model LeagueEntry {
  id          String    @id @default(cuid())
  leagueId    String
  userId      String
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  league League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks  LeagueEntryPick[]
  scores LeagueEntryScore[]

  traitorsPicks TraitorsEntryPick[]
  survivorDraftSeats        SurvivorDraftSeat[]
  survivorDraftPicks        SurvivorDraftPick[]
  survivorPredictions       SurvivorWeeklyPrediction[]
  survivorBootOrder         SurvivorBootOrderSubmission?
  survivorAuctionBids       SurvivorAuctionBid[]
  survivorOwnedAdvantages   SurvivorOwnedAdvantage[]
  survivorPointTransactions SurvivorPointTransaction[]

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId])
}

model LeagueEntryPick {
  id         String  @id @default(cuid())
  entryId    String
  queenId    String
  slot       Int // 1..4
  multiplier Decimal @db.Decimal(3, 1) // 2.5, 2.0, 1.5, 1.0

  entry LeagueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  queen Queen       @relation(fields: [queenId], references: [id], onDelete: Restrict)

  @@unique([entryId, slot])
  @@index([queenId])
}

model Episode {
  id          String      @id @default(cuid())
  leagueId    String
  week        Int
  episodeType EpisodeType @default(REGULAR) // ✅ NEW
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  league  League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  results EpisodeResult[]
  scores  LeagueEntryScore[]

  // ✅ NEW (finale-only data)
  finalePlacements EpisodeFinalePlacement[]
  finaleExtras     EpisodeFinaleExtra[]

  hasMurder     Boolean @default(false)
  hasBanishment Boolean @default(false)

  lockedAt DateTime?

  banishmentVoteOpensAt  DateTime?
  banishmentVoteClosesAt DateTime?

  murderVoteOpensAt  DateTime?
  murderVoteClosesAt DateTime?

  traitorsPlayerResults TraitorsEpisodePlayerResult[]
  traitorsVotes         TraitorsVote[]

  survivorMeta                  SurvivorEpisodeMeta?
  survivorCastawayResults       SurvivorEpisodeCastawayResult[]
  survivorPredictions           SurvivorWeeklyPrediction[]
  survivorBootOrderSubmissions  SurvivorBootOrderSubmission[] @relation("SurvivorBootOrderMergeEpisode")
  survivorAdvantageExpirations  SurvivorOwnedAdvantage[]      @relation("SurvivorAdvantageExpiresEpisode")
  survivorAdvantageApplications SurvivorOwnedAdvantage[]      @relation("SurvivorAdvantageLastAppliedEpisode")
  survivorPointTransactions     SurvivorPointTransaction[]

  traitorsRoleStarts TraitorsFantasyRolePeriod[] @relation("TraitorsRoleStarts")
  traitorsRoleEnds   TraitorsFantasyRolePeriod[] @relation("TraitorsRoleEnds")

  effectStarts MemberEffect[] @relation("EffectStarts")
  effectEnds   MemberEffect[] @relation("EffectEnds")

  @@unique([leagueId, week])
  @@index([leagueId])
}

model EpisodeResult {
  id        String   @id @default(cuid())
  episodeId String
  type      String // e.g. "mini", "main", "lipsync", "elimination"
  queenId   String? // null allowed (used for "no elimination")
  createdAt DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  queen   Queen?  @relation(fields: [queenId], references: [id], onDelete: Restrict)

  @@index([episodeId])
  @@index([type])
  @@index([queenId])
}

model EpisodeFinalePlacement {
  id        String @id @default(cuid())
  episodeId String
  queenId   String
  place     Int // 1..4

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  queen   Queen   @relation(fields: [queenId], references: [id], onDelete: Restrict)

  @@unique([episodeId, place]) // ✅ prevents two queens being "1st"
  @@unique([episodeId, queenId]) // ✅ prevents same queen twice
  @@index([queenId])
}

model EpisodeFinaleExtra {
  id          String @id @default(cuid())
  episodeId   String
  queenId     String
  miniWins    Int    @default(0)
  mainWins    Int    @default(0)
  lipsyncWins Int    @default(0) // ✅ NEW (supports multiple finale lipsyncs)

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  queen   Queen   @relation(fields: [queenId], references: [id], onDelete: Restrict)

  @@unique([episodeId, queenId])
  @@index([queenId])
}

model LeagueEntryScore {
  id            String  @id @default(cuid())
  leagueEntryId String
  episodeId     String
  points        Decimal @db.Decimal(10, 2)
  breakdown     Json?

  leagueEntry LeagueEntry @relation(fields: [leagueEntryId], references: [id], onDelete: Cascade)
  episode     Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([leagueEntryId, episodeId])
  @@index([episodeId])
  @@index([leagueEntryId])
}
